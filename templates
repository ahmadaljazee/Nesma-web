<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نسمة | حجز خدمة</title>
    <style>
        :root { --main-green: #2e7d32; --light-green: #00c853; }
        body { 
            margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(rgba(255,255,255,0.5), rgba(255,255,255,0.5)), url('/static/bg.png');
            background-size: cover; background-attachment: fixed; color: #0a3d0d;
        }
        .container { max-width: 450px; margin: auto; padding: 20px; text-align: center; }
        .card { background: rgba(255,255,255,0.9); padding: 25px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 1px solid #a5d6a7; }
        input, select { width: 100%; padding: 12px; margin: 10px 0; border: 2px solid var(--main-green); border-radius: 12px; box-sizing: border-box; font-size: 16px; }
        .gps-btn { background: #f0fdf4; border: 1px dashed var(--main-green); padding: 10px; border-radius: 10px; cursor: pointer; margin: 10px 0; color: var(--main-green); font-weight: bold; width: 100%; }
        .submit-btn { background: var(--light-green); color: white; border: none; padding: 15px; width: 100%; border-radius: 30px; font-size: 18px; font-weight: bold; cursor: pointer; transition: 0.3s; margin-top: 15px; }
        .submit-btn:hover { transform: scale(1.03); background: #00e676; }
        .about-box { font-size: 0.9rem; background: #e8f5e9; padding: 15px; border-radius: 12px; margin-bottom: 20px; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="container">
        <img src="/static/logo.png" style="width: 120px; margin-bottom: 10px;">
        <div class="card">
            <h2>نسمة | Nesma</h2>
            <div class="about-box">
                نسمة توفر لكِ نخبة من العاملات المختصات لضمان أعلى معايير التعقيم والترتيب بخصوصية تامة.
            </div>
            
            <form action="/book" method="POST" id="bookingForm">
                <input type="text" name="name" placeholder="👤 الاسم الكامل" required>
                <input type="tel" name="phone" placeholder="📞 رقم الجوال" required>
                <select name="cleaner">
                    <option>سناء م. ⭐ 4.9</option>
                    <option>أمل ع. ⭐ 4.7</option>
                    <option>ريم س. ⭐ 4.8</option>
                </select>
                <input type="date" name="date" required>
                <input type="time" name="time" required>

                <input type="hidden" id="lat" name="lat">
                <input type="hidden" id="lon" name="lon">
                
                <div class="gps-btn" onclick="getLocation()" id="gpsStatus">
                    📍 اضغط لتحديد موقع منزلك تلقائياً
                </div>

                <button type="submit" class="submit-btn">تأكيد الحجز (واتساب)</button>
            </form>
        </div>
        <p style="font-size: 12px; font-weight: bold; margin-top: 30px;">Nesmajo © 2026</p>
    </div>

    <script>
        function getLocation() {
            const status = document.getElementById("gpsStatus");
            if (navigator.geolocation) {
                status.innerText = "⏳ جاري تحديد الموقع...";
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        document.getElementById("lat").value = position.coords.latitude;
                        document.getElementById("lon").value = position.coords.longitude;
                        status.innerText = "✅ تم تحديد موقعك بنجاح";
                        status.style.background = "#dcfce7";
                    },
                    () => {
                        status.innerText = "❌ تعذر تحديد الموقع. يرجى تفعيل الـ GPS";
                    }
                );
            } else {
                status.innerText = "❌ متصفحك لا يدعم تحديد الموقع";
            }
        }
    </script>
</body>
</html>
